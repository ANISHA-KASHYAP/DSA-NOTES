// ------------------------- Brute Force -------------------------
// Time Complexity: O(n²)
// Space Complexity: O(1)

class Solution {
public:
    bool isAnagram(string s, string t) {

        // If lengths are different,
        // they can't be anagrams
        if (s.length() != t.length())
            return false;

        // Check every character of s
        for (int i = 0; i < s.length(); i++) {

            int countS = 0;
            int countT = 0;

            // Count frequency of s[i] in string s
            for (int j = 0; j < s.length(); j++) {
                if (s[j] == s[i])
                    countS++;
            }

            // Count frequency of s[i] in string t
            for (int j = 0; j < t.length(); j++) {
                if (t[j] == s[i])
                    countT++;
            }

            // If frequencies are different,
            // strings are not anagrams
            if (countS != countT)
                return false;
        }

        return true;
    }
};




OPTIMAL-// ------------------------- Optimal -------------------------
// Time Complexity: O(n)
// Space Complexity: O(1)

class Solution {
public:
    bool isAnagram(string s, string t) {

        // If lengths are different,
        // they can't be anagrams
        if (s.length() != t.length())
            return false;

        // Frequency array for lowercase letters (a-z)
        int freq[26] = {0};

        // Traverse both strings together
        for (int i = 0; i < s.length(); i++) {

            // Increase frequency for character in s
            freq[s[i] - 'a']++;

            // Decrease frequency for character in t
            freq[t[i] - 'a']--;
        }

        // If any frequency is not zero,
        // the strings are not anagrams
        for (int i = 0; i < 26; i++) {
            if (freq[i] != 0)
                return false;
        }

        // All frequencies are zero
        return true;
    }
};
