BRUTEFORCE-
class Solution {
public:
    int maxProfit(vector<int>& prices) {

        int maxi = 0;

        for(int i = 0; i < prices.size(); i++) {

            for(int j = i + 1; j < prices.size(); j++) {

                int profit = prices[j] - prices[i];

                maxi = max(maxi, profit);
            }
        }

        return maxi;
    }
};


OPTIMAL-
class Solution {
public:
    int maxProfit(vector<int>& prices) {

        int mini = INT_MAX;  // lowest buying price
        int profit = 0;      // maximum profit

        for(int i = 0; i < prices.size(); i++) {

            mini = min(mini, prices[i]);  // find lowest price till now

            int currProfit = prices[i] - mini; // sell today

            profit = max(profit, currProfit);  // store max profit
        }

        return profit;
    }
};
